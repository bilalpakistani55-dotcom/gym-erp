# GYM ERP environment — copy to .env for local development.
# Production desktop builds do not require the gym owner to set these.

GYM_ERP_ENV=development
GYM_ERP_SYNC_PORT=47821
GYM_ERP_SYNC_BIND=0.0.0.0
GYM_ERP_LOG_LEVEL=info

# Optional cloud (leave empty for fully local operation)
GYM_ERP_CLOUD_URL=
GYM_ERP_CLOUD_API_KEY=

# Photo processing
GYM_ERP_MAX_PHOTO_EDGE=1600
GYM_ERP_PHOTO_QUALITY=82

# Face matching (local). Not a claim of perfect accuracy.
GYM_ERP_FACE_MATCH_THRESHOLD=0.42

# Optional fingerprint vendor bridge. The process reads JSON lines from stdin
# and writes one JSON response per line (see docs/handover.md).
# GYM_ERP_FINGERPRINT_COMMAND=C:\GymERP\fingerprint-bridge.exe
